generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

enum ClientStatus {
  ACTIVE
  AT_RISK
  INACTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  OUTBOUND
  PARTNER
  EVENT
}

enum DealStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ActivityEntity {
  USER
  CLIENT
  LEAD
  DEAL
  PROMO_CODE
  TASK
  NOTE
  SYSTEM
}

enum ActivityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  PROMO_APPLIED
  COMPLETED
  LOGIN
  REGISTERED
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  passwordHash      String
  role              Role             @default(MANAGER)
  title             String?
  avatarColor       String           @default("#2154FF")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ownedClients      Client[]         @relation("ClientOwner")
  ownedLeads        Lead[]           @relation("LeadOwner")
  ownedDeals        Deal[]           @relation("DealOwner")
  assignedTasks     Task[]           @relation("TaskAssignee")
  createdTasks      Task[]           @relation("TaskCreator")
  notes             Note[]           @relation("NoteAuthor")
  createdPromoCodes PromoCode[]      @relation("PromoCodeCreator")
  promoUsages       PromoCodeUsage[] @relation("PromoCodeAppliedBy")
  activities        ActivityLog[]    @relation("ActivityActor")
}

model Client {
  id             String           @id @default(cuid())
  name           String
  company        String
  email          String           @unique
  phone          String
  status         ClientStatus     @default(ACTIVE)
  segment        String?
  location       String?
  monthlyValue   Decimal          @db.Decimal(12, 2)
  totalRevenue   Decimal          @default(0) @db.Decimal(12, 2)
  lastContactAt  DateTime?
  ownerId        String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  owner          User             @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  leads          Lead[]
  deals          Deal[]
  notes          Note[]
  tasks          Task[]
  promoUsages    PromoCodeUsage[]
}

model Lead {
  id              String       @id @default(cuid())
  name            String
  company         String
  email           String       @unique
  phone           String
  source          LeadSource
  status          LeadStatus   @default(NEW)
  estimatedValue  Decimal      @db.Decimal(12, 2)
  nextFollowUpAt  DateTime?
  ownerId         String
  clientId        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  owner           User         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  client          Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deals           Deal[]
  notes           Note[]
  tasks           Task[]
}

model Deal {
  id             String          @id @default(cuid())
  title          String
  description    String?
  stage          DealStage       @default(DISCOVERY)
  currency       String          @default("USD")
  grossAmount    Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  netAmount      Decimal         @db.Decimal(12, 2)
  closeDate      DateTime?
  clientId       String
  leadId         String?
  ownerId        String
  promoCodeId    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner          User            @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  promoCode      PromoCode?      @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  notes          Note[]
  tasks          Task[]
  promoUsage     PromoCodeUsage?
}

model Note {
  id         String    @id @default(cuid())
  body       String
  authorId   String
  clientId   String?
  leadId     String?
  dealId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  author     User      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime
  completedAt  DateTime?
  assignedToId String
  createdById  String
  clientId     String?
  leadId       String?
  dealId       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id            String           @id @default(cuid())
  code          String           @unique
  description   String?
  active        Boolean          @default(true)
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int              @default(0)
  discountType  DiscountType
  discountValue Decimal          @db.Decimal(12, 2)
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     User             @relation("PromoCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  deals         Deal[]
  usages        PromoCodeUsage[]
}

model PromoCodeUsage {
  id             String       @id @default(cuid())
  promoCodeId    String
  dealId         String       @unique
  clientId       String
  appliedById    String
  usedAt         DateTime     @default(now())
  dealAmount     Decimal      @db.Decimal(12, 2)
  discountAmount Decimal      @db.Decimal(12, 2)
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2)
  promoCode      PromoCode    @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appliedBy      User         @relation("PromoCodeAppliedBy", fields: [appliedById], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String         @id @default(cuid())
  actorId     String?
  entity      ActivityEntity
  action      ActivityAction
  entityId    String?
  description String
  metadata    Json?
  createdAt   DateTime       @default(now())
  actor       User?          @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity])
}
