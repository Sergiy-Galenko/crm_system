generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

enum ClientStatus {
  ACTIVE
  AT_RISK
  INACTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  OUTBOUND
  PARTNER
  EVENT
}

enum DealStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum ChatBackgroundType {
  ABSTRACT
  SOLID
  GRADIENT
  IMAGE
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ActivityEntity {
  USER
  CLIENT
  LEAD
  DEAL
  MEETING
  PROMO_CODE
  TASK
  NOTE
  SYSTEM
}

enum ActivityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  PROMO_APPLIED
  COMPLETED
  LOGIN
  REGISTERED
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  nickname          String?          @unique
  role              Role             @default(MANAGER)
  roleLabel         String?
  title             String?
  statusMessage     String?
  phone             String?
  location          String?
  bio               String?
  avatarColor       String           @default("#2154FF")
  companyLogoUrl    String?
  lastSeenAt        DateTime?        @default(now())
  chatBackgroundType ChatBackgroundType @default(ABSTRACT)
  chatBackgroundColor String?
  chatBackgroundImageUrl String?
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdBy         User?            @relation("UserHierarchy", fields: [createdById], references: [id], onDelete: SetNull)
  managedUsers      User[]           @relation("UserHierarchy")
  ownedClients      Client[]         @relation("ClientOwner")
  ownedLeads        Lead[]           @relation("LeadOwner")
  ownedDeals        Deal[]           @relation("DealOwner")
  assignedTasks     Task[]           @relation("TaskAssignee")
  createdTasks      Task[]           @relation("TaskCreator")
  assignedMeetings  Meeting[]        @relation("MeetingAssignee")
  createdMeetings   Meeting[]        @relation("MeetingCreator")
  notes             Note[]           @relation("NoteAuthor")
  recordComments    RecordComment[]
  createdPromoCodes PromoCode[]      @relation("PromoCodeCreator")
  promoUsages       PromoCodeUsage[] @relation("PromoCodeAppliedBy")
  activities        ActivityLog[]    @relation("ActivityActor")
  notifications     Notification[]

  @@index([createdById])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Client {
  id             String           @id @default(cuid())
  name           String
  company        String
  email          String           @unique
  phone          String
  status         ClientStatus     @default(ACTIVE)
  segment        String?
  location       String?
  monthlyValue   Decimal          @db.Decimal(12, 2)
  totalRevenue   Decimal          @default(0) @db.Decimal(12, 2)
  lastContactAt  DateTime?
  ownerId        String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  owner          User             @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  leads          Lead[]
  deals          Deal[]
  notes          Note[]
  tasks          Task[]
  meetings       Meeting[]
  promoUsages    PromoCodeUsage[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@index([lastContactAt])
}

model Lead {
  id              String       @id @default(cuid())
  name            String
  company         String
  email           String       @unique
  phone           String
  source          LeadSource
  status          LeadStatus   @default(NEW)
  estimatedValue  Decimal      @db.Decimal(12, 2)
  nextFollowUpAt  DateTime?
  ownerId         String
  clientId        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  owner           User         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  client          Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deals           Deal[]
  notes           Note[]
  tasks           Task[]

  @@index([ownerId])
  @@index([clientId])
  @@index([status])
  @@index([source])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model Deal {
  id             String          @id @default(cuid())
  title          String
  description    String?
  stage          DealStage       @default(DISCOVERY)
  currency       String          @default("USD")
  grossAmount    Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  netAmount      Decimal         @db.Decimal(12, 2)
  closeDate      DateTime?
  clientId       String
  leadId         String?
  ownerId        String
  promoCodeId    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner          User            @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  promoCode      PromoCode?      @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  notes          Note[]
  tasks          Task[]
  promoUsage     PromoCodeUsage?

  @@index([clientId])
  @@index([leadId])
  @@index([ownerId])
  @@index([promoCodeId])
  @@index([stage])
  @@index([closeDate])
  @@index([createdAt])
}

model Note {
  id         String    @id @default(cuid())
  body       String
  authorId   String
  clientId   String?
  leadId     String?
  dealId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  author     User      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([clientId, createdAt])
  @@index([leadId, createdAt])
  @@index([dealId, createdAt])
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  tags         String[]     @default([])
  dueDate      DateTime
  completedAt  DateTime?
  assignedToId String?
  createdById  String
  clientId     String?
  leadId       String?
  dealId       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  comments     RecordComment[]

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assignedToId])
  @@index([createdById])
  @@index([clientId])
  @@index([leadId])
  @@index([dealId])
  @@index([status, dueDate])
  @@index([assignedToId, status])
}

model Meeting {
  id           String        @id @default(cuid())
  title        String
  description  String?
  status       MeetingStatus @default(SCHEDULED)
  startsAt     DateTime
  endsAt       DateTime
  location     String?
  meetingLink  String?
  outcome      String?
  clientId     String
  assignedToId String
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo   User          @relation("MeetingAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  comments     RecordComment[]

  @@index([startsAt])
  @@index([status])
  @@index([clientId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status, startsAt])
}

model RecordComment {
  id             String   @id @default(cuid())
  body           String
  editedAt       DateTime?
  mentionUserIds String[] @default([])
  authorId       String
  taskId         String?
  meetingId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  meeting        Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([taskId, createdAt])
  @@index([meetingId, createdAt])
}


model PromoCode {
  id            String           @id @default(cuid())
  code          String           @unique
  description   String?
  active        Boolean          @default(true)
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int              @default(0)
  discountType  DiscountType
  discountValue Decimal          @db.Decimal(12, 2)
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     User             @relation("PromoCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  deals         Deal[]
  usages        PromoCodeUsage[]

  @@index([createdById])
  @@index([active])
  @@index([expiresAt])
  @@index([usedCount])
}

model PromoCodeUsage {
  id             String       @id @default(cuid())
  promoCodeId    String
  dealId         String       @unique
  clientId       String
  appliedById    String
  usedAt         DateTime     @default(now())
  dealAmount     Decimal      @db.Decimal(12, 2)
  discountAmount Decimal      @db.Decimal(12, 2)
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2)
  promoCode      PromoCode    @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appliedBy      User         @relation("PromoCodeAppliedBy", fields: [appliedById], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@index([clientId])
  @@index([appliedById])
  @@index([usedAt])
}

model ActivityLog {
  id          String         @id @default(cuid())
  actorId     String?
  entity      ActivityEntity
  action      ActivityAction
  entityId    String?
  description String
  metadata    Json?
  createdAt   DateTime       @default(now())
  actor       User?          @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity])
  @@index([actorId])
  @@index([entity, createdAt])
}
