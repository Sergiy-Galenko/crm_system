generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/auth-client"
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

model AuthAccount {
  id           String   @id
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
